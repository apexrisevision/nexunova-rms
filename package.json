{
  "name": "nexunova-rms",
  "version": "1.0.0",
  "description": "Nexunova RMS — Recovery Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "shots": "node scripts/capture-screenshots.js",
    "check": "node scripts/predeploy-check.js",
    "check:forms": "node scripts/smoke-forms.js",
    "check:pages": "node scripts/smoke-pages.js",
    "check:all": "node scripts/predeploy-check.js && node scripts/smoke-forms.js && node scripts/smoke-pages.js",
    "predeploy": "node scripts/predeploy-check.js",
    "smoke:portal": "node scripts/smoke-portal.js",
    "gate": "node scripts/predeploy-check.js && node scripts/smoke-portal.js",
    "backup": "node scripts/backup-full.js",
    "backup:quick": "node scripts/backup-full.js --skip-audit",
    "verify:desk": "node scripts/verify-reserve-desk.js",
    "measure:overpaint": "node scripts/measure-desk-overpaint.js",
    "shot:daybook": "node scripts/shot-daybook.js",
    "shot:availability": "node scripts/shot-availability.js",
    "verify:status-nature": "node scripts/verify-status-nature-ui.js",
    "shot:desk": "node scripts/shot-desk-bulk.js",
    "shot:floorplan": "node scripts/shot-floorplan.js LG && node scripts/shot-floorplan.js GF && node scripts/shot-floorplan.js FF && node scripts/shot-floorplan.js SF && node scripts/shot-floorplan.js TF",
    "plan:audit": "node scripts/plan-audit.js"
  },
  "build": {
    "appId": "com.nexunova.rms",
    "productName": "Nexunova RMS",
    "copyright": "Copyright © 2026 Nexunova",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!demo-react/**",
      "!supabase/**",
      "!*.md",
      "!*.docx",
      "!node_modules/.cache/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexunova RMS"
    }
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.6.0",
    "xlsx": "^0.18.5"
  }
}
