# ── Dependencies ──────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Electron build outputs ───────────────────────────────
dist/

# ── Supabase CLI local cache (auto-managed, not for repo) ─
supabase/.temp/

# ── Vestigial / dev-only ─────────────────────────────────
demo-react/

# ── Backup files ─────────────────────────────────────────
*.bak
*.bak-*
*.electron-bak

# ── Tooling / Editors ────────────────────────────────────
.claude/
.vscode/
.idea/
*.swp

# ── MCP local config (contains Supabase access token) ────
# .mcp.json holds an access token. So does any copy of it — a .backup left
# behind by an edit is the same secret with a different name, and was one
# "git add ." away from being published.
.mcp.json
.mcp.json.*

# ── OS noise ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Internal docs (not for public repo) ──────────────────
*.docx
BLUEPRINT.md
# …but the rule above was written for the root BLUEPRINT.md and, being
# unanchored, it also swallows every BLUEPRINT.md at any depth. Module specs
# under docs/ are deliverables and must be tracked.
!docs/*/BLUEPRINT.md
REPORT.md
STEP_*_REPORT.md

# ── Local helpers ────────────────────────────────────────
test-splash.js

# Database snapshots — contain real tenant data (PII, password hashes, OTP tokens). Never commit.
backups/

# ── Local secrets for the browser harness. NEVER commit. ─────────
.env.local
